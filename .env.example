# 資料庫、ECPay 等其他必要設定請參考 README；此區為 Resend SMTP。
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_your_resend_api_key
SMTP_USE_TLS=true
SMTP_USE_SSL=false
MAIL_FROM=orders@order.meishifu.org
MAIL_FROM_NAME=美師傅 meishifu
MAIL_REPLY_TO=

# 正式 Cloud Run 使用 Cloud Tasks；本機留空會改成同步寄送。
MAIL_TASKS_PROJECT=
MAIL_TASKS_LOCATION=asia-east1
MAIL_TASKS_QUEUE=
