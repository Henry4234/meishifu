# 本機開發直接連線；Cloud Run deployment 會覆寫為 127.0.0.1:13306 Tailscale proxy。
DB_HOST=192.168.0.1
DB_PORT=3306
DB_AC=AC
DB_PW=PW

# --- 對外網址 (組合金流回呼網址用) ---
BACKEND_BASE_URL=http://localhost:5001
FRONTEND_BASE_URL=http://localhost:5500/frontend

# --- 綠界 ECPay 金流 ---
# 不填則使用綠界官方「測試商店」參數，可直接用測試信用卡跑完整流程。
# 正式上線務必填入自己的商店代號與 HashKey/HashIV，並將 ECPAY_ENV 改為 production。
ECPAY_MERCHANT_ID=2000132
ECPAY_HASH_KEY=5294y06JbISpM5x9
ECPAY_HASH_IV=v77hoKGq4kWxNNIS
ECPAY_ENV=stage

# --- 綠界物流 (店到店電子地圖) ---
# 物流的商店代號與金流是兩組不同的帳號。全家店到店 / 7-11 交貨便屬於 C2C，
# 預設為綠界 C2C 測試特店 2000933。
ECPAY_LOGISTICS_MERCHANT_ID=2000933
# 選店結果的回傳網址，預設為前台同源的 /api/logistics/map-reply（需公開可連）
# ECPAY_MAP_REPLY_URL=https://meishifu.org/api/logistics/map-reply

# --- 訂單通知信 (SMTP) ---
# 未填 SMTP_HOST 時不會真的寄信，只在後端 log 印出信件內容。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=no-reply@meishifu.org
MAIL_FROM_NAME=美師傅 meishifu
